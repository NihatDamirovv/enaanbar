{
  "name": "ena-anbar",
  "productName": "ENA Anbar",
  "version": "1.1.0",
  "description": "ENA Anbar — avtobus şirkəti üçün anbar (FIFO), avtobuslar, qeydlər və çıxış cədvəli",
  "main": "main.js",
  "private": true,
  "author": "Nihat Damirov",
  "scripts": {
    "start": "electron .",
    "test": "node test/run.js",
    "dist": "electron-builder --win nsis",
    "icons": "node scripts/make-icon.js",
    "server": "node server.js"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "rcedit": "^4.0.1",
    "sharp": "^0.34.5"
  },
  "build": {
    "appId": "az.ena.anbar",
    "productName": "ENA Anbar",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/shots.js",
      "ui/**",
      "build/icon.png",
      "package.json",
      "!**/node_modules/**"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "ENA Anbar",
      "artifactName": "ENA-Anbar-Setup-${version}.exe",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "perMachine": false,
      "createStartMenuShortcut": true
    },
    "afterPack": "scripts/after-pack.js",
    "publish": null
  }
}
